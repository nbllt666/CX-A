# ===== Agent 元层（不提交） =====
.trae/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== 数据与配置（含本地密钥 / API Key，绝不提交） =====
data/
config.json
logs/
*.key

# ===== 前端 =====
frontend/node_modules/
frontend/dist/
frontend/release/
frontend/test-results/
frontend/playwright-report/

# ===== 打包产物（installer/build.py 输出，本地重建即可） =====
release/
node_modules/
dist/
build/

# ===== 开发态运行时环境（便携根布局：runtime/conda、runtime/voice，本地重建） =====
# 注意：必须锚定为 /runtime/（仅根目录）——未锚定的 runtime/ 会连 lite/runtime/ 一并吞掉（20260926 修复）
/runtime/

# ===== 测试缓存 =====
.pytest_cache/
.coverage
htmlcov/

# ===== 工具下载缓存（scripts/update_llama_bundled.py 等，本地重建即可） =====
.cache/

# ===== 内置组件源（本地填充，二进制不入 git；保留目录占位） =====
# installer/bundled/ 下的真实组件（如 pet_model 桌宠 VRM ~15MB）体积大，
# 与其它内置组件同为「本地填充」口径：不入 git，但打包链路照常包含。
installer/bundled/*
!installer/bundled/.gitkeep

# ===== 第三方源码（手动克隆 / 管理） =====
MeloTTS/

# ===== 杂项 =====
*.log
.DS_Store
.idea/
.vscode/
*.swp